+GSInterface::ReplacementBinding GSInterface::find_replacement_image(const TextureDescriptor &desc, const TEX0Bits &game_tex0, const ivec4 &uv_bb)
+{
+	ReplacementBinding binding;
+	replacement_stats.lookups++;
+	TextureReplacement rep;
+	if (!texture_replacer || !texture_replacer->lookup_replacement(desc, game_tex0, rep))
+		return binding;
+
+	if (rep.scale_x == 0 || rep.scale_y == 0 || rep.orig_width == 0 || rep.orig_height == 0 ||
+	    rep.width != rep.orig_width * rep.scale_x || rep.height != rep.orig_height * rep.scale_y)
+	{
+		replacement_stats.rejected++;
+		return binding;
+	}
+
+	// Only the rectangle the host identified may be replaced. If the sampled window is larger than that rectangle (e.g. a 512x32 texture of which only
+	// 336x24 texels were uploaded), the draw must stay inside the rectangle, otherwise the original texture is used.
+	const TexRect &r = desc.rect;
+	const bool window_inside = r.x >= rep.origin_x && r.y >= rep.origin_y &&
+	                           r.x + r.width <= rep.origin_x + rep.orig_width && r.y + r.height <= rep.origin_y + rep.orig_height;
+	const bool draw_inside = uv_bb.x >= int(rep.origin_x) && uv_bb.y >= int(rep.origin_y) &&
+	                         uv_bb.z < int(rep.origin_x + rep.orig_width) && uv_bb.w < int(rep.origin_y + rep.orig_height);
+	if (!window_inside && !draw_inside)
+	{
+		replacement_stats.rejected++;
+		return binding;
+	}
+
+	// The image is the whole replacement (shared by every window of the texture); the key identifies it.
+	const uint64_t key = rep.key;
+	replacement_clock++;
+	auto itr = replacement_images.find(key);
+	if (itr == replacement_images.end())
+	{
+		const uint8_t *pixels = rep.rgba ? rep.rgba : texture_replacer->replacement_pixels(rep.key);
+		if (!pixels)
+		{
+			replacement_stats.rejected++;
+			return binding;
+		}
+
+		Vulkan::ImageCreateInfo info = Vulkan::ImageCreateInfo::immutable_2d_image(rep.width, rep.height, VK_FORMAT_R8G8B8A8_UNORM);
+		Vulkan::ImageInitialData initial = { pixels, rep.width, rep.height };
+		auto image = renderer.get_device()->create_image(info, &initial);
+		if (!image)
+		{
+			replacement_stats.rejected++;
+			return binding;
+		}
+
+		ReplacementImage entry;
+		entry.image = std::move(image);
+		entry.bytes = uint64_t(rep.width) * rep.height * 4;
+		replacement_stats.images_created++;
+		replacement_stats.resident_bytes += entry.bytes;
+		itr = replacement_images.emplace(key, std::move(entry)).first;
+
+		// Keep the cache inside its budget: drop the least recently used entries (in flight references keep the image alive).
+		while (replacement_budget && replacement_stats.resident_bytes > replacement_budget && replacement_images.size() > 1)
+		{
+			auto victim = replacement_images.end();
+			for (auto it = replacement_images.begin(); it != replacement_images.end(); ++it)
+				if (it->first != key && (victim == replacement_images.end() || it->second.last_use < victim->second.last_use))
+					victim = it;
+			if (victim == replacement_images.end())
+				break;
+			replacement_stats.resident_bytes -= victim->second.bytes;
+			replacement_stats.images_evicted++;
+			replacement_images.erase(victim);
+		}
+		itr = replacement_images.find(key);
+	}
+
+	itr->second.last_use = replacement_clock;
+	replacement_stats.hits++;
+	binding.image = itr->second.image;
+	binding.linear = rep.linear;
+	binding.origin_x = rep.origin_x;
+	binding.origin_y = rep.origin_y;
+	binding.width = rep.orig_width;
+	binding.height = rep.orig_height;
+	return binding;
+}
