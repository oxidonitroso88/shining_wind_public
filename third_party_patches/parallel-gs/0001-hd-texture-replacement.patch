+void GSInterface::set_texture_replacer(TextureReplacer *replacer, uint64_t budget_bytes)
+{
+	texture_replacer = replacer;
+	replacement_budget = budget_bytes;
+	if (!replacer)
+	{
+		replacement_images.clear();
+		replacement_stats.resident_bytes = 0;
+	}
+}
