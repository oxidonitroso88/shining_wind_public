+// Optional host-provided replacement of a game texture by a higher resolution image (HD texture packs).
+// The host decides *which* texture it is (identity) from the TextureDescriptor; parallel-gs only substitutes the image that is sampled.
+// VRAM, the original texture upload and every UV / clamp / region coordinate stay in the original texel space: the replacement covers the
+// same rectangle of the original texture with `scale_x` x `scale_y` texels per original texel.
+struct TextureReplacement
+{
+	uint64_t key = 0;               // host-defined identity of the replacement image; equal keys must mean equal pixels
+	const uint8_t *rgba = nullptr;  // optional: RGBA8, top-left origin, width * height * 4 bytes, alpha already in GS range (0x80 = opaque); when null,
+	                                // replacement_pixels(key) is asked for it, and only if the image is not cached yet
+	uint32_t width = 0, height = 0; // replacement size in texels
+	uint32_t scale_x = 1, scale_y = 1; // replacement texels per original texel (integers)
+	uint32_t origin_x = 0, origin_y = 0; // top-left of the replaced rectangle in original texture space
+	uint32_t orig_width = 0, orig_height = 0; // size of the replaced rectangle in original texels (width == orig_width * scale_x)
+	bool linear = true;             // sample the replacement with bilinear filtering instead of the game's filter
+};
+
+class TextureReplacer
+{
+public:
+	virtual ~TextureReplacer() = default;
+	// Called when a texture is bound to a render pass (not per draw). Return true and fill `out` to substitute the image.
+	// `game_tex0` is the TEX0 register as the game wrote it (the descriptor normalises palette fields such as CBP away).
+	virtual bool lookup_replacement(const TextureDescriptor &desc, const TEX0Bits &game_tex0, TextureReplacement &out) = 0;
+	// The pixels of a replacement image (same layout as TextureReplacement::rgba), valid until the next call. Null when they cannot be produced.
+	virtual const uint8_t *replacement_pixels(uint64_t key) { (void)key; return nullptr; }
+};
+
+struct TextureReplacementStats
+{
+	uint64_t lookups = 0;       // descriptors offered to the replacer
+	uint64_t hits = 0;          // replacements bound
+	uint64_t rejected = 0;      // replacer said yes but the window does not fit / the image could not be created
+	uint64_t images_created = 0;
+	uint64_t images_evicted = 0;
+	uint64_t resident_bytes = 0;
+};
