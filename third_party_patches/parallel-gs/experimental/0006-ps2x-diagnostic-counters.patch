diff --git a/gs/ps2x_diag.hpp b/gs/ps2x_diag.hpp
new file mode 100644
index 0000000..f3353d5
--- /dev/null
+++ b/gs/ps2x_diag.hpp
@@ -0,0 +1,93 @@
+#pragma once
+// ps2x diagnostic counters (perf 0016). Read-only instrumentation of how the CPU side of parallel-gs synchronises with the GPU: nothing here changes control flow.
+// Written by the thread that feeds the GS (relaxed atomics, a few increments per flush) and read by the runtime's perf report (PS2X_PERF).
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace ps2xdiag
+{
+	// FlushReason values (page_tracker.hpp) in declaration order
+	constexpr int kReasons = 7; // FBPointer, Overflow, TextureHazard, CopyHazard, SubmissionFlush, PressureFlush, HostAccess
+
+	enum SubmitOrigin : int
+	{
+		ORIGIN_INTERNAL = 0, // GSRenderer-internal flush_submit(0): scanout/vsync, readbacks, palette/cache paths
+		ORIGIN_EXPLICIT = 1, // GSInterface::flush()
+		ORIGIN_PRESSURE = 2, // PressureFlush
+		ORIGIN_HOST = 3,     // HostAccess (host reads/writes of GPU-owned VRAM pages)
+		ORIGIN_COUNT = 4
+	};
+
+	struct Counters
+	{
+		// GSRenderer::flush_submit
+		std::atomic<uint64_t> submitCalls{0};
+		std::atomic<uint64_t> submitByOrigin[ORIGIN_COUNT]{};
+		// Device::next_frame_context() as called from flush_submit: includes the wait for the GPU to finish the work recorded one ring turn ago (4 contexts).
+		std::atomic<uint64_t> nfcCalls{0};
+		std::atomic<uint64_t> nfcNs{0};
+		std::atomic<uint64_t> nfcMaxNs{0};
+		std::atomic<uint64_t> nfcOver[4]{}; // calls that took longer than 0.2 ms, 1 ms, 4 ms, 16 ms
+		// GSRenderer::wait_timeline (CPU waits for a GPU timeline value: host access to GPU data)
+		std::atomic<uint64_t> tlCalls{0};
+		std::atomic<uint64_t> tlNs{0};
+		std::atomic<uint64_t> tlMaxNs{0};
+		// GSInterface::flush_render_pass(reason): every call, and the ones that really had primitives
+		std::atomic<uint64_t> passCalls[kReasons]{};
+		std::atomic<uint64_t> passNonEmpty[kReasons]{};
+		std::atomic<uint64_t> passPrims[kReasons]{};
+	};
+
+	// one instance shared by every translation unit (parallel-gs is built before C++17: no inline variables)
+	inline Counters &diag() noexcept
+	{
+		static Counters c;
+		return c;
+	}
+
+	inline void raiseMax(std::atomic<uint64_t> &m, uint64_t v) noexcept
+	{
+		uint64_t cur = m.load(std::memory_order_relaxed);
+		while (v > cur && !m.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
+	}
+	inline void noteSubmit(int origin) noexcept
+	{
+		diag().submitByOrigin[origin].fetch_add(1, std::memory_order_relaxed);
+	}
+	inline void noteNextFrameContext(uint64_t ns) noexcept
+	{
+		diag().nfcCalls.fetch_add(1, std::memory_order_relaxed);
+		diag().nfcNs.fetch_add(ns, std::memory_order_relaxed);
+		raiseMax(diag().nfcMaxNs, ns);
+		static constexpr uint64_t kLimits[4] = { 200000ull, 1000000ull, 4000000ull, 16000000ull };
+		for (int i = 0; i < 4; ++i)
+			if (ns > kLimits[i])
+				diag().nfcOver[i].fetch_add(1, std::memory_order_relaxed);
+	}
+	inline void noteTimelineWait(uint64_t ns) noexcept
+	{
+		diag().tlCalls.fetch_add(1, std::memory_order_relaxed);
+		diag().tlNs.fetch_add(ns, std::memory_order_relaxed);
+		raiseMax(diag().tlMaxNs, ns);
+	}
+	inline void notePass(int reason, uint32_t primitives) noexcept
+	{
+		if (reason < 0 || reason >= kReasons)
+			return;
+		diag().passCalls[reason].fetch_add(1, std::memory_order_relaxed);
+		if (primitives)
+		{
+			diag().passNonEmpty[reason].fetch_add(1, std::memory_order_relaxed);
+			diag().passPrims[reason].fetch_add(primitives, std::memory_order_relaxed);
+		}
+	}
+	struct Stopwatch
+	{
+		std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+		uint64_t ns() const noexcept
+		{
+			return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+		}
+	};
+}
